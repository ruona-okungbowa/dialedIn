{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "dialedin-game",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      },
      "hof": {
        "entry": "hof.html"
      },
      "lab": {
        "entry": "lab.html"
      },
      "vote": {
        "entry": "vote.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "media": {
    "dir": "assets"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "dialedin-game",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "daily-post-creation": {
        "endpoint": "/internal/scheduler/create-daily-post",
        "cron": "0 0 * * *"
      }
    }
  },
  "dev": {
    "subreddit": "dialedin_game_dev"
  }
}
